{
  "name": "@sammorrowdrums/tool-cli",
  "version": "1.0.2",
  "description": "Authenticated MCP-to-shell CLI and bridge with progressive tool discovery",
  "license": "MIT",
  "author": "Sam Morrow <info@sam-morrow.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamMorrowDrums/tool-cli.git"
  },
  "bugs": {
    "url": "https://github.com/SamMorrowDrums/tool-cli/issues"
  },
  "homepage": "https://github.com/SamMorrowDrums/tool-cli#readme",
  "keywords": [
    "ai-agents",
    "cli",
    "json-rpc",
    "mcp",
    "model-context-protocol",
    "progressive-discovery",
    "shell",
    "tool-discovery"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server-entry.d.ts",
      "import": "./dist/server-entry.js"
    },
    "./client": {
      "types": "./dist/client-entry.d.ts",
      "import": "./dist/client-entry.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tool-cli": "./dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "pretest": "npm run clean && npm run build",
    "test": "vitest --run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:verify": "node scripts/verify-package.mjs",
    "release:tag-check": "node scripts/verify-release-tag.mjs",
    "audit": "npm audit --audit-level=high",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "release:check": "npm run clean && npm run lint && npm run format:check && npm run check && npm test && npm run package:verify && npm run audit",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run release:check"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
